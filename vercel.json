{
  "version": 2,
  "outputDirectory": "viewer",
  "ignoreCommand": "bash scripts/vercel_ignore.sh",
  "functions": {
    "api/schedules/dispatch.mjs": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "odds-freshness": {
      "schedule": "7,22,37,52 * * * *",
      "function": "api/schedules/dispatch"
    },
    "game-context-rollover": {
      "schedule": "0 6 * * 2",
      "function": "api/schedules/dispatch"
    },
    "game-context-daily": {
      "schedule": "30 10 * * *",
      "function": "api/schedules/dispatch"
    },
    "close-quality-capture": {
      "schedule": "3,18,33,48 0-5,12-23 * * *",
      "function": "api/schedules/dispatch"
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/precommit",
      "destination": "/verify/index.html"
    },
    {
      "source": "/precommit/",
      "destination": "/verify/index.html"
    },
    {
      "source": "/ledger",
      "destination": "/index.html"
    },
    {
      "source": "/audit",
      "destination": "/index.html"
    },
    {
      "source": "/verify/:id*",
      "destination": "/verify.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/r/:hash",
      "destination": "/r/index.html"
    },
    {
      "source": "/r/:hash/",
      "destination": "/r/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "propstein.vercel.app"
        }
      ],
      "destination": "https://propstein.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!widget/line-pricer(?:/|$)).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://a.espncdn.com https://cdn.nba.com https://resources.premierleague.com; connect-src 'self' https:; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/widget/line-pricer/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; frame-ancestors *; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.(json|csv)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(slate_[^/.]+|snapshots_[^/.]+)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(|index.html|ledger|audit|verify)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
